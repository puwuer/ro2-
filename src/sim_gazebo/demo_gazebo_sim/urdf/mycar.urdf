<?xml version="1.0" encoding="utf-8"?>
<!-- mycar URDF: 坐标系 x前 y左 z上, z=0 为地面; 所有单位为米 -->
<!-- 轮心高于主体底面 3cm, 主体离地 1.9cm; 四轮关节轴均指向车外 -->
<!-- 轮子直接通过中心轮轴与主体连接(轮轴为主体一部分, 从侧面伸入轮心) -->
<robot name="mycar">

  <material name="black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <material name="dark_grey">
    <color rgba="0.25 0.25 0.25 1"/>
  </material>
  <material name="camera_grey">
    <color rgba="0.15 0.15 0.18 1"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.064" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.26 0.14 0.09"/>
      </geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin xyz="0.08 0.08 -0.015" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.05"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <visual>
      <origin xyz="0.08 -0.08 -0.015" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.05"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <visual>
      <origin xyz="-0.08 0.08 -0.015" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.05"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <visual>
      <origin xyz="-0.08 -0.08 -0.015" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.05"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.26 0.14 0.09"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="3.46e-3" ixy="0" ixz="0" iyy="9.46e-3" iyz="0" izz="1.09e-2"/>
    </inertial>
  </link>

  <link name="wheel_fl">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.049" length="0.045"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.049" length="0.045"/>
      </geometry>
      <!-- 轮子-地面摩擦: 默认值偏小会导致麦克纳姆轮打滑(轮子转但车不走) -->
      <surface>
        <friction>
          <ode>
            <mu>2.0</mu>
            <mu2>2.0</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="1.15e-4" ixy="0" ixz="0" iyy="1.15e-4" iyz="0" izz="1.80e-4"/>
    </inertial>
  </link>

  <joint name="wheel_fl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fl"/>
    <origin xyz="0.08 0.098 -0.015" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_fr">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.049" length="0.045"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.049" length="0.045"/>
      </geometry>
      <!-- 轮子-地面摩擦: 默认值偏小会导致麦克纳姆轮打滑(轮子转但车不走) -->
      <surface>
        <friction>
          <ode>
            <mu>2.0</mu>
            <mu2>2.0</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="1.15e-4" ixy="0" ixz="0" iyy="1.15e-4" iyz="0" izz="1.80e-4"/>
    </inertial>
  </link>

  <joint name="wheel_fr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fr"/>
    <origin xyz="0.08 -0.098 -0.015" rpy="0 0 3.14159"/>
    <axis xyz="0 -1 0"/>
  </joint>

  <link name="wheel_rl">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.049" length="0.045"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.049" length="0.045"/>
      </geometry>
      <!-- 轮子-地面摩擦: 默认值偏小会导致麦克纳姆轮打滑(轮子转但车不走) -->
      <surface>
        <friction>
          <ode>
            <mu>2.0</mu>
            <mu2>2.0</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="1.15e-4" ixy="0" ixz="0" iyy="1.15e-4" iyz="0" izz="1.80e-4"/>
    </inertial>
  </link>

  <joint name="wheel_rl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rl"/>
    <origin xyz="-0.08 0.098 -0.015" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_rr">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.049" length="0.045"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.049" length="0.045"/>
      </geometry>
      <!-- 轮子-地面摩擦: 默认值偏小会导致麦克纳姆轮打滑(轮子转但车不走) -->
      <surface>
        <friction>
          <ode>
            <mu>2.0</mu>
            <mu2>2.0</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="1.15e-4" ixy="0" ixz="0" iyy="1.15e-4" iyz="0" izz="1.80e-4"/>
    </inertial>
  </link>

  <joint name="wheel_rr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rr"/>
    <origin xyz="-0.08 -0.098 -0.015" rpy="0 0 3.14159"/>
    <axis xyz="0 -1 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0325" length="0.06"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0325" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="8.46e-5" ixy="0" ixz="0" iyy="8.46e-5" iyz="0" izz="7.92e-5"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.075" rpy="0 0 0"/>
  </joint>

  <!-- IMU: 装在雷达后方 5cm, 紧贴车体上表面(车体 box 高 0.09 -> 上表面 z=+0.045,
       IMU 厚 0.005 -> 中心 z=0.045+0.0025=0.0475) -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.005"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.005"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="3.3e-7" ixy="0" ixz="0" iyy="3.3e-7" iyz="0" izz="6.7e-7"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.05 0 0.0475" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.16 0.04"/>
      </geometry>
      <material name="camera_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.16 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="2.27e-4" ixy="0" ixz="0" iyy="3.42e-5" iyz="0" izz="2.34e-4"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.105 0 0.065" rpy="0 0 0"/>
  </joint>
  <!-- 运动控制插件(麦克纳姆轮) -->
  <gazebo>
    <plugin
        filename="ignition-gazebo-mecanum-drive-system"
        name="ignition::gazebo::systems::MecanumDrive">
        <front_left_joint>wheel_fl_joint</front_left_joint>
        <front_right_joint>wheel_fr_joint</front_right_joint>
        <!-- Fortress 的 MecanumDrive 认 back_left/back_right，写成 rear_* 会静默失效 -->
        <back_left_joint>wheel_rl_joint</back_left_joint>
        <back_right_joint>wheel_rr_joint</back_right_joint>
        <wheel_separation>0.196</wheel_separation>
        <wheelbase>0.16</wheelbase>
        <wheel_radius>0.049</wheel_radius>
        <topic>/cmd_vel</topic>
        <max_linear_acceleration>10</max_linear_acceleration>
        <min_linear_acceleration>-10</min_linear_acceleration>
        <max_angular_acceleration>10</max_angular_acceleration>
        <min_angular_acceleration>-10</min_angular_acceleration>
        <max_linear_velocity>0.5</max_linear_velocity>
        <min_linear_velocity>-0.5</min_linear_velocity>
        <max_angular_velocity>1</max_angular_velocity>
        <min_angular_velocity>-1</min_angular_velocity>
      </plugin>
  </gazebo>
  <!-- 里程计发布: /model/mycar/odometry 与 odom->base_footprint 的 TF -->
  <gazebo>
    <plugin filename="ignition-gazebo-odometry-publisher-system"
      name="ignition::gazebo::systems::OdometryPublisher">
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/model/mycar/odometry</odom_topic>
      <tf_topic>/model/mycar/tf</tf_topic>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <dimensions>3</dimensions>
    </plugin>
  </gazebo>
  <!-- 关节状态发布 -->
  <gazebo>
    <plugin filename="ignition-gazebo-joint-state-publisher-system"
      name="ignition::gazebo::systems::JointStatePublisher">
    </plugin>
  </gazebo>
  <!-- 注意: Sensors 渲染系统由"世界"声明(house.sdf / Factory.sdf 里各有一份)。
       不要在这里再声明一次, 否则同一个 server 会加载两个 Sensors 系统,
       导致整个场景被创建两遍 -> Actor skin already exists -> OGRE 断言崩溃。 -->
  <gazebo reference="lidar_link">
  <sensor name='gpu_lidar' type='gpu_lidar'>
    <topic>scan</topic>
    <update_rate>30</update_rate>
    <lidar>
      <scan>
        <horizontal>
          <samples>640</samples>
          <resolution>1</resolution>
          <min_angle>-3.1415926</min_angle>
          <max_angle>3.1415926</max_angle>
        </horizontal>
        <vertical>
          <samples>16</samples>
          <resolution>1</resolution>
          <min_angle>-0.261799</min_angle>
          <max_angle>0.261799</max_angle>
        </vertical>
      </scan>
      <range>
        <min>0.08</min>
        <max>10.0</max>
        <resolution>0.01</resolution>
      </range>
    </lidar>
    <alwaysOn>1</alwaysOn>
    <visualize>true</visualize>
    <!-- frame_id 必须与 URDF 里的 link 名一致，否则 RViz 无法用 TF 变换 -->
    <ignition_frame_id>lidar_link</ignition_frame_id>
  </sensor>
</gazebo>

  <!-- IMU 传感器: 输出 /imu (gz.msgs.IMU -> sensor_msgs/Imu), 供 EKF 融合角速度 -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <topic>imu</topic>
      <update_rate>100</update_rate>
      <always_on>1</always_on>
      <visualize>false</visualize>
      <ignition_frame_id>imu_link</ignition_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.0017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.0017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.0017</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="depth_camera" type="depth_camera">
          <update_rate>10</update_rate>
          <topic>depth_camera</topic>
          <camera>
            <horizontal_fov>1.05</horizontal_fov>
            <image>
              <width>256</width>
              <height>256</height>
              <format>R_FLOAT32</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>10.0</far>
            </clip>
          </camera>
          <alwaysOn>1</alwaysOn>
          <ignition_frame_id>camera_link</ignition_frame_id>
      </sensor>
    <!-- 彩色相机: 输出 /image_raw，供 RViz Image/Camera 显示 -->
    <sensor name="rgb_camera" type="camera">
      <topic>image_raw</topic>
      <update_rate>10</update_rate>
      <camera>
        <horizontal_fov>1.05</horizontal_fov>
        <image>
          <width>256</width>
          <height>256</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
      <alwaysOn>1</alwaysOn>
      <ignition_frame_id>camera_link</ignition_frame_id>
    </sensor>
  </gazebo>
</robot>
