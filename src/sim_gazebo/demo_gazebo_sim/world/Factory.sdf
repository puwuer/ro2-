    <!-- ==================== 被跟踪的人 ==================== -->
    <!-- 位置: 地图像素 (177,241) -> map (-2.125, -1.575), 朝向 -x
         用静态模型(而不是 actor + 插件): 这台 Fortress 里 actor 插件会在 Configure 时
         把自身 Pose 的 X/Y 清零、靠 TrajectoryPose 定位, 而该组件的位姿不会被应用,
         结果人总是停在世界原点。静态模型能稳定地出现在指定坐标, 且 YOLO 能识别。 -->
    <model name='person'>
      <static>true</static>
      <pose>-2.125 -1.575 0 0 0 3.14159</pose>
      <link name='body'>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>model://DoctorFemaleWalk/meshes/DoctorFemaleWalk.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='collision'>
          <geometry>
            <box><size>0.4 0.4 1.7</size></box>
          </geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>
